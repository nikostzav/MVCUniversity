<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="universityModelStoreContainer" CdmEntityContainer="universityEntities">
    <EntitySetMapping Name="courses">
      <EntityTypeMapping TypeName="universityModel.course">
        <MappingFragment StoreEntitySet="course">
          <ScalarProperty Name="idCourse" ColumnName="idCourse" />
          <ScalarProperty Name="courseTitle" ColumnName="courseTitle" />
          <ScalarProperty Name="courseSemester" ColumnName="courseSemester" />
          <ScalarProperty Name="professors_AFM" ColumnName="professors_AFM" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="course_has_student">
      <EntityTypeMapping TypeName="universityModel.course_has_student">
        <MappingFragment StoreEntitySet="course_has_student">
          <ScalarProperty Name="courseID" ColumnName="courseID" />
          <ScalarProperty Name="students_registrationNumber" ColumnName="students_registrationNumber" />
          <ScalarProperty Name="grade" ColumnName="grade" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="professors">
      <EntityTypeMapping TypeName="universityModel.professor">
        <MappingFragment StoreEntitySet="professors">
          <ScalarProperty Name="AFM" ColumnName="AFM" />
          <ScalarProperty Name="name" ColumnName="name" />
          <ScalarProperty Name="surename" ColumnName="surename" />
          <ScalarProperty Name="department" ColumnName="department" />
          <ScalarProperty Name="users_username" ColumnName="users_username" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="secretaries">
      <EntityTypeMapping TypeName="universityModel.secretary">
        <MappingFragment StoreEntitySet="secretaries">
          <ScalarProperty Name="phonenumber" ColumnName="phonenumber" />
          <ScalarProperty Name="name" ColumnName="name" />
          <ScalarProperty Name="surename" ColumnName="surename" />
          <ScalarProperty Name="department" ColumnName="department" />
          <ScalarProperty Name="USERS_USERNAME" ColumnName="USERS_USERNAME" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="students">
      <EntityTypeMapping TypeName="universityModel.student">
        <MappingFragment StoreEntitySet="students">
          <ScalarProperty Name="registrationNumber" ColumnName="registrationNumber" />
          <ScalarProperty Name="name" ColumnName="name" />
          <ScalarProperty Name="surname" ColumnName="surname" />
          <ScalarProperty Name="department" ColumnName="department" />
          <ScalarProperty Name="USERS_USERNAME" ColumnName="USERS_USERNAME" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="sysdiagrams">
      <EntityTypeMapping TypeName="universityModel.sysdiagram">
        <MappingFragment StoreEntitySet="sysdiagrams">
          <ScalarProperty Name="name" ColumnName="name" />
          <ScalarProperty Name="principal_id" ColumnName="principal_id" />
          <ScalarProperty Name="diagram_id" ColumnName="diagram_id" />
          <ScalarProperty Name="version" ColumnName="version" />
          <ScalarProperty Name="definition" ColumnName="definition" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="users">
      <EntityTypeMapping TypeName="universityModel.user">
        <MappingFragment StoreEntitySet="users">
          <ScalarProperty Name="username" ColumnName="username" />
          <ScalarProperty Name="password" ColumnName="password" />
          <ScalarProperty Name="role" ColumnName="role" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>